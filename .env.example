# Grantex credentials — from https://grantex.dev/dashboard
GRANTEX_API_KEY=gx_your_api_key_here
GRANTEX_AGENT_ID=ag_your_agent_id_here
GRANTEX_PRINCIPAL_ID=your-user-uuid-here

# MoltPe credentials — from https://moltpe.com
MOLTPE_TOKEN=your-supabase-jwt-here
MOLTPE_AGENT_ID=your-moltpe-agent-uuid-here

# The x402 endpoint the agent is authorized to call
X402_ENDPOINT=https://moltpe.com/x402/demo/weather

# Spend budget in USDC (max $100 per grant)
BUDGET_USDC=1.00
